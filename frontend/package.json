{
  "name": "lunar-site-nav-frontend",
  "private": true,
  "version": "1.0.0",
  "description": "Lunar landing site navigator. Lunarium and the star backgrounds were made with SI generation.",
  "type": "module",
  "scripts": {
    "textures": "node scripts/fetch-textures.mjs",
    "terrain": "node scripts/fetch-site-terrain.mjs",
    "predev": "node scripts/fetch-textures.mjs --if-missing && node scripts/fetch-site-terrain.mjs --if-missing",
    "dev": "vite",
    "predev:phone": "npm run predev",
    "dev:phone": "vite --mode phone",
    "prebuild": "node scripts/fetch-textures.mjs --if-missing && node scripts/fetch-site-terrain.mjs --if-missing",
    "build": "vite build",
    "test": "node --test",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "geotiff": "^3.0.5",
    "sharp": "^0.35.5",
    "vite": "^8.3.8"
  }
}
