# Not needed on Netlify: public/_redirects forwards /api/* to the backend, so the app's default
# API base (/api) works as-is. Only set this to call a backend URL directly (then also set
# CORS_ORIGINS on the backend). Copy to .env.production (git-ignored) before `npm run build`.
# VITE_API_BASE=https://lunar-landing-site-nav-ymrt.onrender.com
